# The public lobby directory and the table log. Binds 127.0.0.1:9100; nginx
# publishes it at /lobbies/. The directory holds nothing on disk; the table
# log writes to /var/lib/lobbies, the one place it may write, which the
# status panel (same user) reads from.
[Unit]
Description=Monopoly public lobby directory (localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=opspanel
Group=opspanel
ExecStart=/usr/bin/python3 /opt/opspanel/lobbies.py
# /var/lib/lobbies, created and made writable despite ProtectSystem=strict.
StateDirectory=lobbies
StateDirectoryMode=0750
Environment=LOBBIES_STATE=/var/lib/lobbies
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_UNIX
# It only ever listens; it never calls out.
IPAddressAllow=localhost
IPAddressDeny=any
MemoryMax=96M

[Install]
WantedBy=multi-user.target
