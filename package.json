{
  "name": "party-hall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Party Hall: browser board games to play with friends anywhere - Bazaar Barons and Nest Egg.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:turn": "node --env-file-if-exists=.env scripts/turncheck.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^1.47.0",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.5"
  }
}
